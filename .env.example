# ============ 数据库（docker-compose 默认口径） ============
DATABASE_URL=postgres://postgres:workloom@localhost:5432/workloom
# 应用双角色（A3：旁路直写防控——只有 gateway 角色可 INSERT biz_events）
APP_DB_PASSWORD=workloom_dev_app
GATEWAY_DB_PASSWORD=workloom_dev_gateway
DATABASE_APP_URL=postgres://workloom_app:workloom_dev_app@localhost:5432/workloom
DATABASE_GATEWAY_URL=postgres://workloom_gateway:workloom_dev_gateway@localhost:5432/workloom

# ============ LLM（可选；默认 mock，离线可跑通全流程） ============
# mock | deepseek | moonshot | zhipu | openai
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ============ IM 通道（B11/D14；默认 mock，无凭据全流程可跑——与 LLM 同纪律） ============
# mock | dsh-im（真实通道凭据在 dsh 设置页配置：bash scripts/install-im-channels.sh 后 dsh web → IM机器人）
IM_DRIVER=mock

# ============ 演示身份 JWT（B5） ============
# 生产（NODE_ENV=production）必配：缺失直接拒启；<32 字符启动告警（熵不足）
# 生成建议：openssl rand -hex 32
JWT_SECRET=hyperreality-dev-secret-change-me

# ============ PII 脱敏盐（M2-PII；生产必配） ============
# 占位符 HMAC-SHA256 盐（workdata/pii.ts，防彩虹表反推明文）；生产必须注入，变更后新旧占位符不可关联
PII_SALT=workloom-dev-pii-salt

# ============ 服务端口 ============
SERVER_PORT=8787
WEB_PORT=5173

# ============ 视频经理 · 视频制作（vendor/supermickey 引擎） ============
# 渲染（火山引擎方舟；缺省时 render.submit 走 mock 并明确标注）
VOLCENGINE_ARK_API_KEY=
SEEDANCE_ENDPOINT=
SEEDREAM_ENDPOINT=
# 预生产工作目录（checkpoints/characters/confirmations 等运行产物根）
HR_WORK_DIR=.vm-work
# 审批轮询（studio-worker）
HR_APPROVAL_POLL_MS=2000
HR_APPROVAL_TIMEOUT_MS=7200000

# ============ 制片档案与运维闭环（T-2026-0926-0001） ============
# 档案夹：<HR_WORK_DIR>/archive/<workspaceId>/<projectId>/（manifest/events/stages/logs/context-bundle）
# 总开关：0 = 完全回到接入前的行为（回滚开关，语义零变化）
ARCHIVE_ENABLED=1
# server 启动时自动把超时 running 台账置 interrupted 并留 finding（默认 0：只标记，不自动拉起，先人工 resume）
ARCHIVE_AUTO_RESUME=0
# 单环节成本告警阈值（¥；archive-watch 巡检用）
ARCHIVE_WATCH_COST_CAP=50
# 僵死判定：running 环节超过 N 分钟无心跳即判僵死（archive-watch 巡检用）
ARCHIVE_HEARTBEAT_STALE_MIN=30
# 启动扫描：running 台账超过 N 分钟视为"进程已死的遗留"（ARCHIVE_AUTO_RESUME=1 时归位 interrupted）
ARCHIVE_STALE_RUNNING_MIN=10

# ============ WorkLoom GEO · 双域融合经营（bundles/geo-growth） ============
# AI 能见度监测通道（五级分层 L1 官方 API→L3 RPA 剧本→L5 人工；缺省 mock，离线可跑通）
# 监测平台：豆包/DeepSeek/元宝/ChatGPT 四平台先行，出海客户扩展 Perplexity
VISIBILITY_PLATFORMS=doubao,deepseek,yuanbao,chatgpt
VISIBILITY_DRIVER=mock
# 采集节奏：品牌词日频 + 全量 query 集周频（cron 口径）
VISIBILITY_BRAND_CRON=0 21 * * *
VISIBILITY_FULL_CRON=0 9 * * 1
# 信源分发渠道（知乎/头条号/百家号/公众号/新闻稿/垂媒/百科；publish-rpa 扩适配器）
SOURCE_CHANNELS=zhihu,toutiao,baijiahao,gongzhonghao
SOURCE_DRIVER=mock
# 数据边界红线：客户业务数据（客资/WhatsApp 聊天/线索）留客户系统，事件链只记经营动作留痕
DATA_BOUNDARY_STRICT=true

# ============ 工具执行器（真实连接器；B-21 多模块组合） ============
# 逗号列表，支持 `前缀=绝对路径` 路由（按工具名前缀最长匹配）；不带前缀的条目为兜底执行器。
# 例（按本机克隆位置替换）：
# WORKLOOM_TOOL_EXECUTOR_MODULES=visual=/abs/bundles/geo-growth/connectors/visual-bridge/server-adapter.mts,publish=/abs/bundles/geo-growth/connectors/publish-bridge/server-adapter.mts
WORKLOOM_TOOL_EXECUTOR_MODULES=
# 兼容旧单模块变量（等价一条兜底路由；同时配置时以 MODULES 为准）
WORKLOOM_TOOL_EXECUTOR_MODULE=
# B-65 执行器沙箱：模块必须落在这些根内（逗号分隔；缺省 bundles/packages/apps/.workloom-runtime-deps）。
# 模块旁可放 `<文件名>.workloom-executor.json` 声明 { "name": "...", "tools": [...] }，
# 声明后该模块只能执行清单内工具（越权调用返回未核实，不伪造回执）。
WORKLOOM_TOOL_EXECUTOR_ROOTS=
# 视觉工位桥（visual-bridge）：URL 列表逗号分隔（故障转移）+ 令牌只放环境/文件，不进仓库
WORKLOOM_VISUAL_BRIDGE_URLS=
WORKLOOM_VISUAL_BRIDGE_TOKEN=
WORKLOOM_VISUAL_BRIDGE_TOKEN_FILE=
WORKLOOM_VISUAL_BRIDGE_TIMEOUT_MS=300000
# 发布/信源/私域执行器桥（B-20/B-22；浏览器登录态与企微密钥只放桥侧，服务端只持桥令牌）
WORKLOOM_PUBLISH_BRIDGE_URL=
WORKLOOM_PUBLISH_BRIDGE_TOKEN=
WORKLOOM_SOURCE_BRIDGE_URL=
WORKLOOM_SOURCE_BRIDGE_TOKEN=
WORKLOOM_PRIVATE_DOMAIN_BRIDGE_URL=
WORKLOOM_PRIVATE_DOMAIN_BRIDGE_TOKEN=

# ============ agent/system 写通道（B-38；未配置 → 通道整体关闭，fail-closed） ============
# 内部数字员工（x-workloom-agent）与白名单系统组件（x-workloom-system）经此密钥调用
# collaboration/arbitration 写路径；事件 who.type 落 agent/system，不再冒充人类成员。
# 要求 ≥16 字符；只放环境/秘密存储，不进仓库、不进日志。
WORKLOOM_AGENT_KEY=

# ============ 契约自治预算带（B-40；单位与契约币种一致） ============
# 结算金额 ≤ 带 → 内部协作自动结算；> 带 → 结算前须有一道业务关卡放行（>10×带升 L4）。
WORKLOOM_CONTRACT_BUDGET_BAND=500

# ============ 事件总线（B-31；memory 内嵌 / nats / redis 外部） ============
EVENT_BUS=memory
NATS_URL=nats://127.0.0.1:4222
REDIS_URL=

# ============ B-32 四类真实连接器（缺任一 → fail-closed，不回退 mock） ============
PMS_URL=
PMS_TOKEN=
OTA_MONITOR_URL=
OTA_MONITOR_TOKEN=
WECOM_URL=
WECOM_TOKEN=
DOUYIN_LOCAL_URL=
DOUYIN_LOCAL_TOKEN=

# ============ OTA 素材上传（B-19；凭证只放环境/秘密存储） ============
CTRIP_OTA_URL=
CTRIP_OTA_TOKEN=
MEITUAN_OTA_URL=
MEITUAN_OTA_TOKEN=
FLIGGY_OTA_URL=
FLIGGY_OTA_TOKEN=

# ============ AI 服务前台（C 端，ToBToC） ============
# C 端会话与工单挂载的工作区（缺省取首个工作区；GEO 双域部署建议显式指定）
SERVICE_C_WORKSPACE_ID=
# h5 演示直登开关（生产置 false 后仅 code 换 openid）
SERVICE_C_DEMO_AUTH=true
# C 端令牌密钥（生产必填，>=32 字符）
SERVICE_C_SECRET=

# ============ 桌面端首启种子脚本（按仓配置；不在 base-sync 同步范围，各仓自定） ============
DESKTOP_SEED_SCRIPT=scripts/seed-geo.ts
